<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <DefineConstants>$(DefineConstants);USE_PADDLE_OCR</DefineConstants>
    <NoWarn>$(NoWarn);CA1416;CS8602;CS8604</NoWarn>
  </PropertyGroup>

  <!-- Debug 模式不使用管理员权限，Release 模式使用 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)' == 'Debug'" />
    
    <PackageReference Include="Sdcb.PaddleOCR" Version="3.0.1" />
    <PackageReference Include="Sdcb.PaddleOCR.Models.Local" Version="3.0.1" />
    <PackageReference Include="Sdcb.PaddleOCR.Models.LocalV5" Version="3.0.0" />
    <PackageReference Include="Sdcb.PaddleInference.runtime.win64.cu129_cudnn910_sm89" Version="3.1.0.54" />
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="**\*.xaml" Exclude="bin\**;obj\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 排除 test_simple 目录中的所有 .cs 文件 -->
    <Compile Remove="OcrEngine.cs" />
    <Compile Remove="test_simple\**\*.cs" />
    <Compile Remove="resource\**\*.cs" />
    <None Include="test_simple\**\*.cs" />
    
    <!-- 排除 test 目录 -->
    <Compile Remove="test\**\*" />
    <None Remove="test\**\*" />
    <Content Remove="test\**\*" />
    <EmbeddedResource Remove="test\**\*" />
    
    <!-- 排除 UE4.27.2 目录 -->
    <Compile Remove="RapidOCR.Net\**\*" />
    <Compile Remove="UE4.27.2\**\*" />
    <None Remove="UE4.27.2\**\*" />
    <Content Remove="UE4.27.2\**\*" />
    <EmbeddedResource Remove="UE4.27.2\**\*" />
    
    <!-- 排除 Dumper-7 目录 -->
    <Compile Remove="Dumper-7\**\*" />
    <None Remove="Dumper-7\**\*" />
    <Content Remove="Dumper-7\**\*" />
    <EmbeddedResource Remove="Dumper-7\**\*" />
    
    <!-- 排除 ida-pro-mcp 目录 -->
    <Compile Remove="ida-pro-mcp\**\*" />
    <None Remove="ida-pro-mcp\**\*" />
    <Content Remove="ida-pro-mcp\**\*" />
    <EmbeddedResource Remove="ida-pro-mcp\**\*" />
    
    <!-- 排除 cheat-engine-server-python 目录 -->
    <Compile Remove="cheat-engine-server-python\**\*" />
    <None Remove="cheat-engine-server-python\**\*" />
    <Content Remove="cheat-engine-server-python\**\*" />
    <EmbeddedResource Remove="cheat-engine-server-python\**\*" />
  </ItemGroup>

</Project>